---
import type { Product } from '../../types/shop';

interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCardTitle(title: string): string {
  let t = title;
  if (t.startsWith('Elbi Stempel aus Holz - ')) {
    t = t.replace(/^Elbi Stempel aus Holz\s*-\s*/, '');
  } else if (t.startsWith('Stempel aus Holz - ')) {
    t = t.replace(/^Stempel aus Holz\s*-\s*/, '');
  } else if (t.startsWith('Elbi Lehrerstempel - ')) {
    t = t.replace(/^Elbi Lehrerstempel\s*-\s*/, '');
  }

  if (t.startsWith('Lehrer Motivstempel - ')) {
    return t.replace(/^Lehrer Motivstempel\s*-\s*/, 'Lehrer Motivstempel ');
  }
  if (t.startsWith('Erfolgsstempel - ')) {
    return t.replace(/^Erfolgsstempel\s*-\s*/, 'Erfolgsstempel ');
  }

  return t.split(' - ')[0];
}

function formatPriceEur(cents: number): string {
  return (cents / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
}

const displayTitle = formatCardTitle(product.title);
const displaySubtitle = product.short_description || (product.title.replace(displayTitle, '').replace(/^[\s\-]+/, ''));

const vatPercent = product.vat_percent ?? product.vat_rate ?? 19;
const stockCount = product.stock ?? product.stock_quantity ?? 0;
const isAvailable = stockCount > 0;
const isHeft = product.sku.startsWith('H') || product.title.toLowerCase().includes('heft') || product.title.toLowerCase().includes('schreib');
const isStempel = product.sku.startsWith('S') || product.sku.startsWith('K') || product.title.toLowerCase().includes('stempel');
const categoryTag = isHeft ? 'hefte' : (isStempel ? 'stempel' : 'other');
---

<article
  class="group relative flex flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white transition-all duration-300 hover:shadow-xl hover:border-slate-300 hover:-translate-y-1 product-catalog-item"
  data-sku={product.sku}
  data-category={categoryTag}
>
  <!-- Product Image Container -->
  <div class="aspect-[4/3] w-full overflow-hidden bg-[#f8f9fa] p-4 sm:p-5 group-hover:opacity-95 transition-opacity flex items-center justify-center border-b border-slate-100 rounded-t-3xl relative">
    {product.image_url ? (
      <img
        src={product.image_url}
        alt={product.title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain drop-shadow-xs group-hover:scale-[1.03] transition-transform duration-300"
        onerror="this.onerror=null; this.src='/images/placeholder.svg'"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-slate-100 text-slate-400">
        <span class="text-sm font-semibold tracking-wider uppercase">ELBI Verlag</span>
      </div>
    )}
  </div>

  <!-- Content & Details with Generous Breathing Room -->
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="mb-2 flex items-center">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold font-mono text-slate-700 bg-slate-100 border border-slate-200/80">
        <span class="font-sans font-semibold text-slate-500 text-[11px]">Art.-Nr.:</span>
        <span>{product.sku}</span>
      </span>
    </div>

    <h3 data-ai-editable="product_card_title" data-ai-name={`Produkt-Titel (${product.sku})`} data-product-slug={product.slug} class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-[#3395d1] transition-colors leading-snug font-sans tracking-tight">
      <a href={`/products/${product.slug}`} class="block">
        <span aria-hidden="true" class="absolute inset-0"></span>
        {displayTitle}
      </a>
    </h3>

    <p class="mt-2 line-clamp-2 text-[15px] text-slate-600 leading-relaxed font-sans">
      {displaySubtitle}
    </p>

    <!-- Price & Quick Add Section (PAngV Compliant) -->
    <div class="mt-auto pt-4 border-t border-slate-100 flex flex-col gap-3">
      <div class="flex items-baseline justify-between">
        <span class="text-xl font-extrabold text-slate-900 font-sans tracking-tight">
          {formatPriceEur(product.price_cents)}
        </span>
        {isAvailable ? (
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            Sofort lieferbar
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-rose-700 bg-rose-50 px-2.5 py-0.5 rounded-full border border-rose-200/60">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
            Derzeit vergriffen
          </span>
        )}
      </div>

      <div class="flex items-center justify-between gap-2 pt-0.5">
        <!-- Statutory Price Transparency Notice (PAngV) -->
        <p class="text-[11px] text-slate-500 leading-tight">
          inkl. {vatPercent}% MwSt., zzgl. <a href="https://dev.elbi.de/versand" class="underline hover:text-blue-600 relative z-10">Versand</a>
        </p>

        <!-- Direct Quick Add To Basket Button with Authentic Cart Icon -->
        <button
          type="button"
          disabled={!isAvailable}
          data-sku={product.sku}
          data-title={displayTitle}
          data-price={product.price_cents}
          data-image={product.image_url}
          aria-label={!isAvailable ? `${displayTitle} (Derzeit vergriffen)` : `${displayTitle} in den Warenkorb legen`}
          title={!isAvailable ? `${displayTitle} (Derzeit vergriffen)` : `${displayTitle} in den Warenkorb legen`}
          class={`quick-cart-add-btn relative z-10 inline-flex items-center justify-center h-9 w-9 sm:h-10 sm:w-10 rounded-full transition-all shadow-2xs border focus:outline-none focus:ring-2 focus:ring-[#0b57d0] focus:ring-offset-1 shrink-0 ${
            !isAvailable
              ? 'bg-slate-100 text-slate-300 border-slate-200 cursor-not-allowed opacity-50'
              : 'bg-slate-100/90 hover:bg-slate-200/90 border-slate-300/80 text-slate-700 hover:text-[#0b57d0] hover:border-[#0b57d0]/50 active:scale-95 cursor-pointer'
          }`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 6h13M9 20a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2zM12 7v4m-2-2h4"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</article>
