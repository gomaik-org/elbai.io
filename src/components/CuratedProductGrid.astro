---
import { getAllProducts } from '../data/catalog';
import rawCategories from '../data/categories.json';

const allProducts = getAllProducts();
// Filter to valid active products with real images
const validProducts = allProducts.filter((p) => p.image_url && !p.image_url.includes('placeholder'));

// Curated active categories: Schreibhefte & Stempel
const schreibhefte = validProducts.filter((p) => p.sku.startsWith('H') || p.category_id?.includes('schreibhefte') || p.title.toLowerCase().includes('heft') || p.title.toLowerCase().includes('schreib'));
const stempel = validProducts.filter((p) => p.sku.startsWith('S') || p.sku.startsWith('K') || p.title.toLowerCase().includes('stempel'));

function formatPriceEur(cents: number): string {
  return (cents / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
}

function cleanTitle(title: string): string {
  return title
    .replace(/^Elbi Stempel aus Holz\s*-\s*/, '')
    .replace(/^Stempel aus Holz\s*-\s*/, '')
    .replace(/^Elbi Lehrerstempel\s*-\s*/, '')
    .split(' - ')[0];
}
---

<section id="shop-catalog" class="w-full max-w-7xl mx-auto px-4 py-12 border-t border-slate-800/80">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold mono text-cyan-300 bg-cyan-950/60 border border-cyan-800/60 mb-2">
        <span>📦</span>
        <span>Original ELBI Verlagssortiment</span>
        <span class="text-slate-500">•</span>
        <span class="text-emerald-400 font-bold">{validProducts.length} aktive Bestseller-Artikel</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Praxiserprobte Lehrmittel &amp; Schreibhefte
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-1 max-w-2xl">
        Keine Test-Dummies, keine Altlasten: Hier sind die echten ca. 50 Kern-Artikel von Elbi – direkt aus dem Schulalltag.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex items-center gap-2 mono text-xs">
      <button id="filter-all-btn" class="filter-tab active px-4 py-2 rounded-xl bg-cyan-500 text-slate-950 font-bold transition">
        Alle ({validProducts.length})
      </button>
      <button id="filter-hefte-btn" class="filter-tab px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-750 transition">
        Schreibhefte ({schreibhefte.length})
      </button>
      <button id="filter-stempel-btn" class="filter-tab px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-750 transition">
        Lehrerstempel ({stempel.length})
      </button>
    </div>
  </div>

  <!-- Product Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="product-card-grid">
    {validProducts.map((p) => {
      const isHeft = p.sku.startsWith('H') || p.title.toLowerCase().includes('heft') || p.title.toLowerCase().includes('schreib');
      const isStempel = p.sku.startsWith('S') || p.sku.startsWith('K') || p.title.toLowerCase().includes('stempel');
      const tag = isHeft ? 'hefte' : (isStempel ? 'stempel' : 'other');
      const title = cleanTitle(p.title);

      return (
        <article 
          class="product-card group flex flex-col justify-between rounded-2xl bg-[#0f111a] border border-slate-800/80 hover:border-cyan-500/50 p-4 transition-all duration-300 hover:shadow-[0_0_25px_rgba(6,182,212,0.15)] hover:-translate-y-1"
          data-category={tag}
        >
          <div>
            <!-- Image Area -->
            <div class="aspect-square w-full rounded-xl bg-white/95 p-4 flex items-center justify-center overflow-hidden mb-4 shadow-inner relative">
              <img 
                src={p.image_url} 
                alt={p.title} 
                loading="lazy" 
                class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm"
                onerror="this.onerror=null; this.src='/images/placeholder.svg'"
              />
              <span class="absolute top-2 left-2 px-2 py-0.5 rounded bg-slate-900/90 text-[10px] mono text-cyan-300 font-bold border border-slate-700">
                {p.sku}
              </span>
            </div>

            <!-- Meta Tags -->
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[10px] mono uppercase font-semibold text-slate-400 px-2 py-0.5 rounded bg-slate-900 border border-slate-800">
                {isHeft ? 'Schreibheft' : 'Holzstempel'}
              </span>
              <span class="text-[10px] mono text-emerald-400 font-medium">Auf Lager</span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="font-bold text-white text-base leading-snug line-clamp-2 group-hover:text-cyan-300 transition-colors">
              {title}
            </h3>
            {p.short_description && (
              <p class="text-xs text-slate-400 mt-1.5 line-clamp-2 leading-relaxed">
                {p.short_description}
              </p>
            )}
          </div>

          <!-- Bottom: Price & Badge -->
          <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-500 mono block">Preis inkl. MwSt.</span>
              <span class="text-lg font-black text-cyan-400 mono">
                {formatPriceEur(p.price_gross ?? p.price_net ?? 290)}
              </span>
            </div>
            <span class="px-3 py-1.5 rounded-lg bg-cyan-950/80 border border-cyan-800/60 text-cyan-300 hover:text-white text-xs mono font-bold group-hover:border-cyan-400 transition">
              Elbi Original
            </span>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  // Simple tab filtering
  const allBtn = document.getElementById('filter-all-btn');
  const hefteBtn = document.getElementById('filter-hefte-btn');
  const stempelBtn = document.getElementById('filter-stempel-btn');
  const cards = document.querySelectorAll('.product-card');

  function setFilter(cat: string, activeBtn: HTMLElement) {
    [allBtn, hefteBtn, stempelBtn].forEach(b => {
      b?.classList.remove('bg-cyan-500', 'text-slate-950', 'active');
      b?.classList.add('bg-slate-900', 'text-slate-300');
    });
    activeBtn.classList.add('bg-cyan-500', 'text-slate-950', 'active');
    activeBtn.classList.remove('bg-slate-900', 'text-slate-300');

    cards.forEach(card => {
      const c = card.getAttribute('data-category');
      if (cat === 'all' || c === cat) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  allBtn?.addEventListener('click', () => setFilter('all', allBtn));
  hefteBtn?.addEventListener('click', () => setFilter('hefte', hefteBtn));
  stempelBtn?.addEventListener('click', () => setFilter('stempel', stempelBtn));
</script>
