---
// Alpha Sandbox Interactive Floating Widget (Non-modal, draggable/docked floating card)
---
<div id="alpha-sandbox-container">
  <!-- Inline Script for instant synchronous modal toggling -->
  <script is:inline>
    function toggleAlphaSandbox(force) {
      var m = document.getElementById('sandbox-modal');
      var b = document.getElementById('copilot-hint-badge');
      if (!m) return;
      var isHidden = m.classList.contains('hidden') || m.style.display === 'none' || window.getComputedStyle(m).display === 'none';
      var show = (typeof force === 'boolean') ? force : isHidden;
      if (show) {
        m.classList.remove('hidden');
        m.style.display = 'flex';
        if (b) b.style.display = 'none';
        if (typeof window.__alphaLoadSnapshots === 'function') {
          window.__alphaLoadSnapshots();
        }
      } else {
        m.classList.add('hidden');
        m.style.display = 'none';
      }
    }
    window.__toggleAlphaSandbox = toggleAlphaSandbox;
  </script>

  <!-- Floating Launcher Button Bottom-Right with Glowing Beacon & Tooltip -->
  <div class="fixed bottom-5 right-5 z-[100] flex flex-col items-end gap-2 pointer-events-auto">
    
    <!-- Animated Callout Badge ("Hier klicken & Shop anpassen!") -->
    <div id="copilot-hint-badge" class="animate-bounce flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500 text-white text-[11px] font-bold shadow-lg border border-sky-300">
      <span>✨</span>
      <span>Hier klicken &amp; Shop anpassen!</span>
      <span class="text-sky-200">👇</span>
    </div>

    <!-- Glowing Pill Button with Cyan Aura Pulse -->
    <button 
      id="sandbox-toggle-btn" 
      onclick="toggleAlphaSandbox()"
      class="group relative flex items-center gap-2.5 px-5 py-3 rounded-full bg-slate-900/95 hover:bg-black text-white font-bold text-xs tracking-wide shadow-[0_0_25px_rgba(14,165,233,0.6)] hover:shadow-[0_0_35px_rgba(14,165,233,0.9)] border-2 border-sky-400 hover:border-sky-300 backdrop-blur-md hover:scale-105 active:scale-95 transition-all cursor-pointer ring-4 ring-sky-400/20"
      aria-label="Alpha Copilot & Zeitmaschine öffnen"
    >
      <span class="text-lg group-hover:rotate-12 transition-transform">🤖</span>
      <span class="tracking-normal font-sans text-sm font-extrabold text-white">Copilot &amp; Zeitmaschine</span>
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-sky-400"></span>
      </span>
    </button>
  </div>

  <!-- Non-Modal Floating Compact Window (fixed position bottom-right) -->
  <div id="sandbox-modal" class="fixed bottom-16 right-4 sm:right-5 z-[101] hidden w-[92vw] sm:w-[420px] h-[520px] max-h-[80vh] bg-slate-900/95 text-slate-100 border border-slate-700/80 rounded-2xl shadow-2xl backdrop-blur-md flex flex-col overflow-hidden transition-all duration-200 pointer-events-auto">
    
    <!-- Compact Header -->
    <div class="p-3.5 px-4 bg-slate-950/90 border-b border-slate-800 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2.5">
        <span class="text-lg">🤖</span>
        <div>
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span>Shop-Copilot &amp; Zeitmaschine</span>
            <span class="px-1.5 py-0.2 rounded text-[9px] mono bg-sky-950 text-sky-300 border border-sky-800 font-bold uppercase">D1 Live</span>
          </h3>
          <p class="text-[11px] text-slate-400">Änderungen werden live im Shop sichtbar</p>
        </div>
      </div>
      <button id="sandbox-close-btn" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-xs transition cursor-pointer" title="Schließen">
        ✕
      </button>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-slate-800 bg-slate-950/50 text-xs font-semibold shrink-0">
      <button id="tab-btn-assistant" class="flex-1 py-2.5 px-3 border-b-2 border-sky-400 text-sky-400 bg-sky-950/20 flex items-center justify-center gap-1.5 cursor-pointer">
        <span>✨ 1. Shop anpassen</span>
      </button>
      <button id="tab-btn-history" class="flex-1 py-2.5 px-3 border-b-2 border-transparent text-slate-400 hover:text-white flex items-center justify-center gap-1.5 cursor-pointer">
        <span>⏳ 2. Zeitmaschine (Snapshots)</span>
      </button>
    </div>

    <!-- Scrollable Body Container -->
    <div id="sandbox-scroll-container" class="flex-1 overflow-y-auto p-4 space-y-4 text-xs">
      
      <!-- VIEW 1: ASSISTANT -->
      <div id="view-assistant" class="space-y-3.5">
        
        <!-- Suggestions -->
        <div>
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-1.5">Klickbare Beispiele:</span>
          <div class="grid grid-cols-1 gap-1.5">
            <button class="suggestion-chip text-left px-3 py-2 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/60 text-sky-300 transition cursor-pointer">
              Färbe die Überschrift pink
            </button>
            <button class="suggestion-chip text-left px-3 py-2 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/60 text-sky-300 transition cursor-pointer">
              Banner oben: "Schulen bestellen bei uns bequem auf Rechnung!"
            </button>
            <button class="suggestion-chip text-left px-3 py-2 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/60 text-sky-300 transition cursor-pointer">
              Titel zu: "ELBI – Freude am Schreibenlernen"
            </button>
          </div>
        </div>

        <!-- Prompt Form -->
        <form id="assistant-form" class="space-y-2.5">
          <label for="user-prompt" class="block font-semibold text-slate-300">
            Eigene Anweisung an den Copiloten:
          </label>
          <div class="relative">
            <textarea
              id="user-prompt"
              rows="3"
              placeholder="z.B. 'Färbe die Überschrift pink', 'Schalte Banner ein...', 'Ändere Überschrift zu...'"
              class="w-full rounded-xl bg-slate-950/80 border border-slate-700 p-3 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400 transition"
              required
            ></textarea>
          </div>

          <button
            type="submit"
            id="assistant-submit-btn"
            class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold tracking-wide shadow-lg transition flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="btn-spinner" class="hidden animate-spin">⚡</span>
            <span id="btn-text">Im Shop anwenden &amp; Snapshot sichern</span>
          </button>
        </form>

        <div id="assistant-status" class="hidden p-3 rounded-xl text-xs"></div>
      </div>

      <!-- VIEW 2: TIME MACHINE (SNAPSHOTS) -->
      <div id="view-history" class="hidden space-y-3.5">
        <div class="p-2.5 rounded-xl bg-slate-950/60 border border-slate-800 text-[11px] text-slate-300 flex items-center justify-between">
          <span>Gespeicherte Stände in Cloudflare D1:</span>
          <div class="flex items-center gap-2">
            <button id="refresh-snapshots-btn" class="text-sky-400 hover:underline cursor-pointer">Neu laden</button>
          </div>
        </div>

        <!-- 1-Click Reset to Initial State Button -->
        <button
          id="reset-to-init-btn"
          type="button"
          class="w-full py-2 px-3 rounded-xl bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 border border-rose-800/60 font-semibold text-xs transition flex items-center justify-center gap-2 cursor-pointer shadow-sm active:scale-98"
        >
          <span>🔄</span>
          <span>Shop komplett auf Init (Standard) zurücksetzen</span>
        </button>

        <div id="rollback-status" class="hidden p-3 rounded-xl text-xs"></div>

        <div id="snapshots-list" class="space-y-2">
          <div class="p-4 text-center text-slate-500">Lade Snapshots...</div>
        </div>
      </div>

    </div>

    <!-- Centered Modal Confirmation Overlay (Fixed directly to #sandbox-modal, unaffected by scrolling) -->
    <div 
      id="rollback-prompt" 
      class="absolute inset-0 z-30 hidden bg-slate-950/90 backdrop-blur-xs flex items-center justify-center p-5 transition-all duration-200"
    >
      <div class="w-full max-w-xs rounded-2xl bg-slate-900 border-2 border-amber-500 p-5 shadow-2xl text-center space-y-3.5">
        <div class="w-12 h-12 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center mx-auto text-2xl font-bold">
          ⏳
        </div>
        <div>
          <h4 class="font-bold text-amber-200 text-sm">Diesen Stand wiederherstellen?</h4>
          <p id="rollback-details" class="text-slate-200 text-xs mt-1.5 leading-snug line-clamp-3 font-medium bg-slate-950/60 p-2.5 rounded-xl border border-slate-800"></p>
        </div>
        <div class="flex gap-2 pt-1">
          <button 
            id="confirm-rollback-btn" 
            class="flex-1 py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition cursor-pointer shadow-lg active:scale-95"
          >
            Ja, jetzt laden
          </button>
          <button 
            id="cancel-rollback-btn" 
            class="py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white font-medium text-xs transition cursor-pointer"
          >
            Abbrechen
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  let activeSnapshotIdToRollback: string | null = null;

  // DOM Elements
  const toggleBtn = document.getElementById('sandbox-toggle-btn');
  const modal = document.getElementById('sandbox-modal');
  const closeBtn = document.getElementById('sandbox-close-btn');

  const tabAssistant = document.getElementById('tab-btn-assistant');
  const tabHistory = document.getElementById('tab-btn-history');
  const viewAssistant = document.getElementById('view-assistant');
  const viewHistory = document.getElementById('view-history');

  const assistantForm = document.getElementById('assistant-form') as HTMLFormElement;
  const userPrompt = document.getElementById('user-prompt') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('assistant-submit-btn');
  const btnSpinner = document.getElementById('btn-spinner');
  const btnText = document.getElementById('btn-text');
  const assistantStatus = document.getElementById('assistant-status');

  const snapshotsList = document.getElementById('snapshots-list');
  const refreshBtn = document.getElementById('refresh-snapshots-btn');
  const rollbackPrompt = document.getElementById('rollback-prompt');
  const rollbackDetails = document.getElementById('rollback-details');
  const confirmRollbackBtn = document.getElementById('confirm-rollback-btn');
  const cancelRollbackBtn = document.getElementById('cancel-rollback-btn');
  const rollbackStatus = document.getElementById('rollback-status');

  // Toggle Window
  const hintBadge = document.getElementById('copilot-hint-badge');
  function toggleSandboxModal(force?: boolean) {
    if (typeof (window as any).toggleAlphaSandbox === 'function') {
      (window as any).toggleAlphaSandbox(force);
    } else {
      const m = document.getElementById('sandbox-modal');
      const badge = document.getElementById('copilot-hint-badge');
      if (!m) return;
      const isHidden = m.classList.contains('hidden') || m.style.display === 'none';
      const show = typeof force === 'boolean' ? force : isHidden;
      if (show) {
        m.classList.remove('hidden');
        m.style.display = 'flex';
        badge?.classList.add('hidden');
        loadStateAndSnapshots();
      } else {
        m.classList.add('hidden');
        m.style.display = 'none';
      }
    }
  }

  // Expose loadStateAndSnapshots globally for inline script
  (window as any).__alphaLoadSnapshots = loadStateAndSnapshots;

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (typeof (window as any).toggleAlphaSandbox === 'function') {
      (window as any).toggleAlphaSandbox(false);
    }
  });

  // Switch Tabs
  tabAssistant?.addEventListener('click', () => {
    tabAssistant.classList.add('border-sky-400', 'text-sky-400', 'bg-sky-950/20');
    tabAssistant.classList.remove('border-transparent', 'text-slate-400');
    tabHistory?.classList.remove('border-sky-400', 'text-sky-400', 'bg-sky-950/20');
    tabHistory?.classList.add('border-transparent', 'text-slate-400');

    viewAssistant?.classList.remove('hidden');
    viewHistory?.classList.add('hidden');
    rollbackPrompt?.classList.add('hidden');
    rollbackPrompt?.classList.remove('flex');
  });

  tabHistory?.addEventListener('click', () => {
    tabHistory.classList.add('border-sky-400', 'text-sky-400', 'bg-sky-950/20');
    tabHistory.classList.remove('border-transparent', 'text-slate-400');
    tabAssistant?.classList.remove('border-sky-400', 'text-sky-400', 'bg-sky-950/20');
    tabAssistant?.classList.add('border-transparent', 'text-slate-400');

    viewHistory?.classList.remove('hidden');
    viewAssistant?.classList.add('hidden');
    rollbackPrompt?.classList.add('hidden');
    rollbackPrompt?.classList.remove('flex');
    loadStateAndSnapshots();
  });

  // Suggestion Chips
  document.querySelectorAll('.suggestion-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (userPrompt) {
        userPrompt.value = (btn.textContent || '').trim();
        userPrompt.focus();
      }
    });
  });

  // Hydrate DOM with Active State
  function applyLiveState(state: any) {
    if (!state) return;

    // 1. Headline Text & Color (Home or Product Detail Page)
    const heroTitle = document.getElementById('shop-hero-headline');
    if (heroTitle) {
      if (state.hero_title) {
        heroTitle.textContent = state.hero_title;
      }
      if (state.hero_title_color) {
        heroTitle.style.color = state.hero_title_color;
      } else {
        heroTitle.style.color = '';
      }
    }

    // Product Detail Page Title & Color
    const productTitle = document.getElementById('product-detail-title');
    if (productTitle && state.products) {
      const slugMatch = window.location.pathname.match(/\/products\/([^\/\?#]+)/);
      const slug = slugMatch ? slugMatch[1] : null;
      if (slug && state.products[slug]) {
        const pState = state.products[slug];
        if (pState.title) {
          productTitle.textContent = pState.title;
        }
        if (pState.title_color) {
          productTitle.style.color = pState.title_color;
        } else {
          productTitle.style.color = '';
        }
      }
    }

    // 2. Subtitle Text
    const heroSubtitle = document.getElementById('shop-hero-subtitle');
    if (heroSubtitle && state.hero_subtitle) {
      heroSubtitle.textContent = state.hero_subtitle;
    }

    // 3. Alpha Banner
    const banner = document.getElementById('dynamic-alpha-banner');
    const bannerText = document.getElementById('dynamic-alpha-banner-text');
    if (banner && bannerText) {
      if (state.banner_text && (state.banner_visible !== false)) {
        bannerText.textContent = state.banner_text;
        banner.classList.remove('hidden');
      } else {
        banner.classList.add('hidden');
      }
    }
  }

  // Fetch Current State & Snapshots from D1
  async function loadStateAndSnapshots() {
    try {
      const res = await fetch('/api/state');
      const data = await res.json();

      if (data.success) {
        applyLiveState(data.state);
        renderSnapshots(data.snapshots);
      }
    } catch (e) {
      console.warn('Live state sync error:', e);
    }
  }

  // Render Snapshots list
  function renderSnapshots(snapshots: any[]) {
    if (!snapshotsList) return;
    if (!snapshots || snapshots.length === 0) {
      snapshotsList.innerHTML = `<div class="p-3 text-center text-slate-500">Keine Snapshots vorhanden.</div>`;
      return;
    }

    snapshotsList.innerHTML = snapshots
      .map(
        (s) => {
          const title = s.summary || s.label || 'Snapshot';
          const time = s.created_at ? new Date(s.created_at).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) : '';
          return `
          <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800 hover:border-slate-700 transition flex items-center justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="font-bold text-white text-xs truncate">${title}</div>
              <div class="text-[10px] mono text-slate-400 mt-0.5">
                Snapshot #${s.id} ${time ? '&bull; ' + time + ' Uhr' : ''}
              </div>
            </div>
            <button 
              data-id="${s.id}" 
              data-label="${title.replace(/"/g, '&quot;')}"
              class="rollback-btn px-2.5 py-1.5 rounded-lg bg-sky-950 hover:bg-sky-900 border border-sky-800 text-sky-300 text-[10px] font-bold transition shrink-0 cursor-pointer"
            >
              Wiederherstellen
            </button>
          </div>
        `;
        }
      )
      .join('');

    // Attach listeners to rollback buttons
    document.querySelectorAll('.rollback-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const label = btn.getAttribute('data-label') || '';
        triggerRollbackDialog(id, label);
      });
    });
  }

  // Trigger Rollback Dialog (Always centered over the modal window)
  function triggerRollbackDialog(id: string, label: string) {
    activeSnapshotIdToRollback = id;
    if (rollbackDetails) {
      rollbackDetails.textContent = label;
    }
    if (rollbackPrompt) {
      rollbackPrompt.classList.remove('hidden');
      rollbackPrompt.classList.add('flex');
      rollbackPrompt.style.display = 'flex';
    }
    rollbackStatus?.classList.add('hidden');
    // Ensure the scroll container resets so the dialog is visible immediately
    const scrollContainer = document.getElementById('sandbox-scroll-container');
    if (scrollContainer) {
      scrollContainer.scrollTop = 0;
    }
  }

  cancelRollbackBtn?.addEventListener('click', () => {
    if (rollbackPrompt) {
      rollbackPrompt.classList.add('hidden');
      rollbackPrompt.classList.remove('flex');
      rollbackPrompt.style.display = 'none';
    }
    activeSnapshotIdToRollback = null;
  });

  // Confirm Rollback Action
  confirmRollbackBtn?.addEventListener('click', async () => {
    if (!activeSnapshotIdToRollback) return;

    confirmRollbackBtn.textContent = 'Stelle her...';
    try {
      const res = await fetch('/api/state', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'rollback',
          snapshotId: activeSnapshotIdToRollback,
        }),
      });

      const result = await res.json();
      if (rollbackPrompt) {
        rollbackPrompt.classList.add('hidden');
        rollbackPrompt.classList.remove('flex');
        rollbackPrompt.style.display = 'none';
      }
      confirmRollbackBtn.textContent = 'Ja, jetzt laden';

      if (result.success) {
        if (rollbackStatus) {
          rollbackStatus.className = 'p-3 rounded-xl bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 text-xs';
          rollbackStatus.textContent = `✓ ${result.message}`;
          rollbackStatus.classList.remove('hidden');
        }
        applyLiveState(result.state);
        loadStateAndSnapshots();
      } else {
        throw new Error(result.error || 'Fehler beim Wiederherstellen');
      }
    } catch (e: any) {
      confirmRollbackBtn.textContent = 'Ja, jetzt laden';
      if (rollbackStatus) {
        rollbackStatus.className = 'p-3 rounded-xl bg-rose-950/80 border border-rose-500/50 text-rose-300 text-xs';
        rollbackStatus.textContent = `Fehler: ${e.message}`;
        rollbackStatus.classList.remove('hidden');
      }
    }
  });

  // 1-Click Reset to Init
  const resetToInitBtn = document.getElementById('reset-to-init-btn');
  resetToInitBtn?.addEventListener('click', async () => {
    if (!confirm('Möchtest du den gesamten Shop wirklich auf die Standard-Werkseinstellungen (Init) zurücksetzen?')) {
      return;
    }

    resetToInitBtn.setAttribute('disabled', 'true');
    const originalText = resetToInitBtn.innerHTML;
    resetToInitBtn.innerHTML = '<span>⚡</span><span>Wird zurückgesetzt...</span>';

    try {
      const res = await fetch('/api/state', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'reset' }),
      });
      const result = await res.json();
      if (result.success) {
        if (rollbackStatus) {
          rollbackStatus.className = 'p-3 rounded-xl bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 text-xs';
          rollbackStatus.textContent = `✓ ${result.message}`;
          rollbackStatus.classList.remove('hidden');
        }
        applyLiveState(result.state);
        loadStateAndSnapshots();
      } else {
        throw new Error(result.error || 'Fehler beim Zurücksetzen');
      }
    } catch (e: any) {
      if (rollbackStatus) {
        rollbackStatus.className = 'p-3 rounded-xl bg-rose-950/80 border border-rose-500/50 text-rose-300 text-xs';
        rollbackStatus.textContent = `Fehler: ${e.message}`;
        rollbackStatus.classList.remove('hidden');
      }
    } finally {
      resetToInitBtn.removeAttribute('disabled');
      resetToInitBtn.innerHTML = originalText;
    }
  });

  // Form Submit (Assistant)
  assistantForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const prompt = userPrompt.value.trim();
    if (!prompt) return;

    btnSpinner?.classList.remove('hidden');
    if (btnText) btnText.textContent = 'Wird verarbeitet...';
    if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
    assistantStatus?.classList.add('hidden');

    try {
      const res = await fetch('/api/state', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'update',
          prompt: prompt,
          pathname: window.location.pathname,
        }),
      });

      const result = await res.json();

      btnSpinner?.classList.add('hidden');
      if (btnText) btnText.textContent = 'Im Shop anwenden & Snapshot sichern';
      if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;

      if (result.success) {
        if (assistantStatus) {
          assistantStatus.className = 'p-3 rounded-xl bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 text-xs';
          assistantStatus.textContent = `✓ ${result.message}`;
          assistantStatus.classList.remove('hidden');
        }
        userPrompt.value = '';
        applyLiveState(result.state);
        loadStateAndSnapshots();
      } else {
        throw new Error(result.error || 'Fehler');
      }
    } catch (err: any) {
      btnSpinner?.classList.add('hidden');
      if (btnText) btnText.textContent = 'Im Shop anwenden & Snapshot sichern';
      if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;

      if (assistantStatus) {
        assistantStatus.className = 'p-3 rounded-xl bg-rose-950/80 border border-rose-500/50 text-rose-300 text-xs';
        assistantStatus.textContent = `Fehler: ${err.message}`;
        assistantStatus.classList.remove('hidden');
      }
    }
  });

  refreshBtn?.addEventListener('click', () => loadStateAndSnapshots());

  // Close dynamic banner handler
  document.getElementById('close-dynamic-banner')?.addEventListener('click', () => {
    document.getElementById('dynamic-alpha-banner')?.classList.add('hidden');
  });

  // Initial Load on page entry
  loadStateAndSnapshots();
</script>
