---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CartDrawer from '../components/cart/CartDrawer';
import { shopConfig } from '../config/shop.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = `${shopConfig.brand.name} – Schulplaner, Lehrerkalender & Lehrmittel`,
  description = shopConfig.brand.description,
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="de" class="h-full bg-gray-50 text-gray-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts: Merriweather (Serif) & Outfit (Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- OpenGraph & Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={shopConfig.brand.name} />
    <meta property="og:image" content="https://elbi.de/images/og-preview.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://elbi.de/images/og-preview.jpg" />

    <!-- LLM Discoverability -->
    <link rel="help" type="text/plain" href="/llms.txt" title="LLM Context & Publisher Information" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schema.org Organization & WebSite -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://elbi.de/#organization",
          "name": "ELBI Verlag GmbH",
          "url": "https://elbi.de",
          "logo": "https://elbi.de/favicon.svg",
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "Kundenservice",
            "availableLanguage": ["German"]
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://elbi.de/#website",
          "url": "https://elbi.de",
          "name": "ELBI Verlag",
          "publisher": {
            "@id": "https://elbi.de/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://elbi.de/catalog?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
  </head>
  <body class="flex min-h-full flex-col">
    <!-- BFSG Accessibility: Skip to main content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-white focus:shadow-lg focus:outline-none"
    >
      Zum Hauptinhalt springen
    </a>

    <!-- Global Header -->
    <Header />

    <!-- Main Content Landmark -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Slide-over Cart Island (Eager hydration for instant responsiveness) -->
    <CartDrawer client:load />

    <!-- Global Footer with Mandatory Legal Links & Withdrawal Button -->
    <Footer />

    <!-- Cloudflare Web Analytics (Privacy-First, Zero-Cookie, DSGVO-compliant) -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "elbi-de-web-analytics"}'
    ></script>
  </body>
</html>
