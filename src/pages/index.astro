          <rect x="485" y="504" width="180" height="4" rx="2" fill="#475569" />
        </g>

        <!-- Articulated Mechanical Arms To Side Monitors -->
        <g filter="url(#armShadow)">
          <!-- Left Arm to Monitor 1 (Vater) -->
          <line x1="220" y1="260" x2="360" y2="340" stroke="#0f172a" stroke-width="22" stroke-linecap="round" />
          <line x1="360" y1="340" x2="550" y2="400" stroke="#0f172a" stroke-width="22" stroke-linecap="round" />
          <line x1="220" y1="260" x2="360" y2="340" stroke="url(#armMetal)" stroke-width="14" stroke-linecap="round" />
          <line x1="360" y1="340" x2="550" y2="400" stroke="url(#armMetal)" stroke-width="14" stroke-linecap="round" />
          <!-- Joints -->
          <circle cx="220" cy="260" r="14" fill="#0f172a" /><circle cx="220" cy="260" r="8" fill="#475569" />
          <circle cx="360" cy="340" r="16" fill="#0f172a" /><circle cx="360" cy="340" r="10" fill="#475569" />

          <!-- Right Arm to Monitor 3 (Sohn) -->
          <line x1="930" y1="260" x2="790" y2="340" stroke="#0f172a" stroke-width="22" stroke-linecap="round" />
          <line x1="790" y1="340" x2="600" y2="400" stroke="#0f172a" stroke-width="22" stroke-linecap="round" />
          <line x1="930" y1="260" x2="790" y2="340" stroke="url(#armMetal)" stroke-width="14" stroke-linecap="round" />
          <line x1="790" y1="340" x2="600" y2="400" stroke="url(#armMetal)" stroke-width="14" stroke-linecap="round" />
          <!-- Joints -->
          <circle cx="930" cy="260" r="14" fill="#0f172a" /><circle cx="930" cy="260" r="8" fill="#475569" />
          <circle cx="790" cy="340" r="16" fill="#0f172a" /><circle cx="790" cy="340" r="10" fill="#475569" />
        </g>
