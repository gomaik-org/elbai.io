        <span>🤖</span>
        <span class="font-bold">elba.io</span>
        <span class="text-slate-500">•</span>
        <span>✨ Next Gen Elbi 💫</span>
      </div>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white mb-3">
        Elbi + AI = <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-fuchsia-400 bg-clip-text text-transparent">elbai.io</span>
      </h1>
      <p class="mono text-xs sm:text-sm text-slate-400 max-w-2xl mx-auto">
        1. elbi.de auf Cloudflare Edge &bull; 2. Erste Automatisierungen mit AI &bull; 3. Next-Gen Tech Lab
      </p>
    </div>

    <!-- WORKSTATION WRAPPER WITH BACKGROUND SVG RIG (emaik.io inspired) -->
