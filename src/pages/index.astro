                  <rect x="28" y="30" width="44" height="40" rx="6" fill="#0f172a" />
                  
                  <!-- Antenna & LED -->
                  <line x1="50" y1="24" x2="50" y2="10" stroke="#38bdf8" stroke-width="2" />
                  <circle cx="50" cy="8" r="4" fill="#06b6d4" class="animate-pulse" />

                  <!-- Visor Screen -->
                  <rect x="34" y="38" width="32" height="14" rx="3" fill="#0284c7" opacity="0.4" />
                  
                  <!-- Animated Blinking Cyan Eyes -->
                  <g class="animate-blink">
                    <circle cx="42" cy="45" r="3.5" fill="#22d3ee" />
                    <circle cx="58" cy="45" r="3.5" fill="#22d3ee" />
