      <!-- 3-MONITOR CONSOLE SUITE -->
      <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-6 items-center w-full">

        <!-- ================= MONITOR 1 (LEFT): VATER'S ANALOG HERITAGE ================= -->
        <div class="md:col-span-3 flex flex-col items-center">
          <div class="w-full max-w-[280px] bg-[#1a1b24] p-2 rounded-xl bezel-shadow border border-[#2d2e3d]">
