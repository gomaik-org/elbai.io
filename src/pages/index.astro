---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="de" class="min-h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>elbAI.io // NEXT-GEN WORKSTATION TAKEOVER</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&family=Space+Grotesk:wght@700;900&family=Press+Start+2P&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Space Grotesk', sans-serif;
      background-color: #08090e;
      color: #e2e8f0;
      overflow-x: hidden;
    }
    .mono { font-family: 'Fira Code', monospace; }
    .pixel { font-family: 'Press Start 2P', monospace; }

    /* CRT Glass & Scanline Aesthetics */
    .crt-screen {
      position: relative;
      background: radial-gradient(circle at center, rgba(14, 165, 233, 0.08) 0%, rgba(3, 7, 18, 0.95) 100%);
    }
    .crt-screen::before {
      content: " ";
      display: block;
      position: absolute;
      inset: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%);
      background-size: 100% 4px;
      z-index: 20;
      pointer-events: none;
      opacity: 0.6;
    }

    /* Screen Glare Sheen */
    .screen-glare {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
      pointer-events: none;
    }

    /* Bezel Frame Drop Shadow */
    .bezel-shadow {
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.8),
                  inset 0 1px 2px rgba(255, 255, 255, 0.15),
                  inset 0 -2px 4px rgba(0, 0, 0, 0.8);
    }

    /* SVG Robotic Arm & Cable Shading */
    .cable-glow {
      filter: drop-shadow(0 0 8px rgba(6, 182, 212, 0.4));
    }

    /* Keyframe Animations */
    @keyframes blink {
      0%, 90%, 100% { transform: scaleY(1); }
      95% { transform: scaleY(0.1); }
    }
    .animate-blink { animation: blink 4s infinite; transform-origin: center; }

    @keyframes pulse-core {
      0%, 100% { r: 18; opacity: 0.8; }
      50% { r: 24; opacity: 1; filter: drop-shadow(0 0 16px #22d3ee); }
    }
    .animate-core { animation: pulse-core 3s ease-in-out infinite; }

    @keyframes ink-draw {
      0% { stroke-dashoffset: 800; }
      50% { stroke-dashoffset: 0; }
      85% { stroke-dashoffset: 0; opacity: 1; }
      100% { stroke-dashoffset: -800; opacity: 0; }
    }
    .animate-ink {
      stroke-dasharray: 800;
      animation: ink-draw 5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes dad-pen-move {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(15px, -8px) rotate(5deg); }
      50% { transform: translate(30px, 4px) rotate(-3deg); }
      75% { transform: translate(45px, -6px) rotate(4deg); }
    }
    .animate-pen { animation: dad-pen-move 5s ease-in-out infinite; }

    @keyframes pulse-led {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 1; }
    }
    .led-pulse { animation: pulse-led 1.5s infinite; }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-cyan-500 selection:text-black">

  <!-- Station HUD Header -->
  <header class="w-full bg-[#0d0e14]/90 border-b border-sky-950/80 px-6 py-3.5 backdrop-blur z-30">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a href="/" class="flex items-center space-x-3 group">
