          <span class="text-xl font-extrabold tracking-tight">elb<span class="text-cyan-400">AI</span>.io</span>
        </a>
        <span class="hidden sm:inline-block ml-3 px-2 py-0.5 rounded text-[10px] mono bg-cyan-950/70 text-cyan-300 border border-cyan-800/60 font-semibold uppercase">
