        </div>
        <a href="#terminal" class="px-3 py-1 rounded bg-sky-950/60 hover:bg-sky-900/80 text-sky-300 border border-sky-800/80 transition">
          CLI_OUTPUT //
        </a>
      </div>
    </div>
  </header>

  <!-- Workstation Stage (SVG Robotic Arms, 3 Monitors & Desk Architecture) -->
