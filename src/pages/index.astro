                      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9"/>
                      <stop offset="100%" stop-color="#0284c7" stop-opacity="0"/>
                    </radialGradient>
                  </defs>

                  <!-- Network Data Highways -->
                  <path d="M 40 80 Q 110 30, 180 80 T 320 80" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-dasharray="6 3" />
                  <path d="M 40 80 Q 110 130, 180 80 T 320 80" fill="none" stroke="#a855f7" stroke-width="2" stroke-dasharray="6 3" />

                  <!-- Central Transformer Core -->
                  <circle cx="180" cy="80" r="32" fill="url(#nodeGlow)" />
                  <circle cx="180" cy="80" r="22" fill="#0f172a" stroke="#38bdf8" stroke-width="2" />
                  <circle cx="180" cy="80" r="16" fill="#06b6d4" class="animate-core" />
                  <text x="180" y="84" font-family="'Fira Code', monospace" font-size="9" font-weight="bold" fill="#ffffff" text-anchor="middle">
                    AI.CORE
                  </text>

                  <!-- Left Node (Papa/Elbi) -->
                  <circle cx="40" cy="80" r="16" fill="#1e1b4b" stroke="#e11d48" stroke-width="2" />
                  <text x="40" y="83" font-family="'Space Grotesk', sans-serif" font-size="8" font-weight="bold" fill="#f43f5e" text-anchor="middle">ELBI</text>

                  <!-- Right Node (Sohn/Edge) -->
                  <circle cx="320" cy="80" r="16" fill="#082f49" stroke="#38bdf8" stroke-width="2" />
                  <text x="320" y="83" font-family="'Space Grotesk', sans-serif" font-size="8" font-weight="bold" fill="#38bdf8" text-anchor="middle">EDGE</text>

                  <!-- Floating Micro-Agent Badges -->
                  <g transform="translate(100, 32)">
                    <rect width="64" height="16" rx="3" fill="#0f172a" stroke="#0284c7" stroke-width="1"/>
                    <text x="32" y="11" fill="#7dd3fc" font-family="'Fira Code', monospace" font-size="8" text-anchor="middle">OCR_SCAN</text>
                  </g>
                  <g transform="translate(195, 112)">
                    <rect width="64" height="16" rx="3" fill="#0f172a" stroke="#a855f7" stroke-width="1"/>
                    <text x="32" y="11" fill="#d8b4fe" font-family="'Fira Code', monospace" font-size="8" text-anchor="middle">D1_STATE</text>
                  </g>
                </svg>

                <!-- Core Punchline Banner in Center Monitor -->
                <div class="bg-black/60 border border-slate-800 rounded-lg p-2.5 max-w-md w-full text-center mt-1">
                  <p class="text-xs sm:text-sm font-bold text-white">
                    "Moderne Cloudflare-Infrastruktur &bull; Erste Automatisierungen mit AI &bull; Next-Gen Vision"
                  </p>
                  <p class="mono text-[10px] text-cyan-400 mt-0.5">
                    // Cloudflare Pages &bull; Workers &bull; D1 SQLite &bull; Google Cloud Gemini Enterprise
                  </p>
                </div>
              </div>

              <!-- Main Terminal Footer -->
              <div class="pt-2 border-t border-sky-950 text-[10px] mono text-slate-400 flex justify-between items-center z-10">
                <span class="text-slate-500">SESSION: ELBAI_ROADMAP_V1</span>
                <span class="text-cyan-400 font-bold">STATUS: RECOMPILED 2026</span>
              </div>
            </div>

            <!-- Monitor Bezel Details -->
            <div class="flex justify-between items-center px-3 pt-2 text-[9px] mono text-slate-500">
              <span class="font-bold tracking-widest">ELBAI-STATION-HQ // PRIMARY</span>
