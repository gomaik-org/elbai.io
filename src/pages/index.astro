        <defs>
          <linearGradient id="armMetal" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#475569"/>
            <stop offset="50%" stop-color="#334155"/>
            <stop offset="100%" stop-color="#0f172a"/>
          </linearGradient>
          <linearGradient id="cableGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0891b2"/>
            <stop offset="50%" stop-color="#06b6d4"/>
            <stop offset="100%" stop-color="#0891b2"/>
          </linearGradient>
          <filter id="armShadow" x="-10%" y="-10%" width="130%" height="130%">
            <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#000000" flood-opacity="0.8"/>
          </filter>
        </defs>

        <!-- Under-Desk Heavy Loop Cables -->
        <g stroke="#090d16" stroke-width="14" fill="none" opacity="0.9" stroke-linecap="round">
          <path d="M 280 480 C 280 540, 420 555, 575 555" />
          <path d="M 870 480 C 870 540, 730 555, 575 555" />
        </g>
        <g stroke="#0369a1" stroke-width="3" fill="none" opacity="0.6" stroke-linecap="round" class="cable-glow">
          <path d="M 282 481 C 282 538, 420 553, 575 553" />
          <path d="M 868 481 C 868 538, 730 553, 575 553" />
        </g>

        <!-- Central Pedestal / Heavy Duty Stand -->
        <g filter="url(#armShadow)">
          <rect x="545" y="380" width="60" height="130" rx="3" fill="#1e293b" stroke="#0f172a" stroke-width="4" />
          <rect x="555" y="380" width="40" height="130" fill="#334155" />
          <!-- Heavy Desk Baseplate -->
