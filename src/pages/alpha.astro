---
import '../styles/global.css';
import AlphaSandboxWidget from '../components/AlphaSandboxWidget.astro';
import ProductCard from '../components/product/ProductCard.astro';
import { getAllProducts } from '../data/catalog';
import { shopConfig } from '../config/shop.config';

const allProducts = getAllProducts();
// Curated active products with valid images
const validProducts = allProducts.filter((p) => p.image_url && !p.image_url.includes('placeholder'));
---
<!doctype html>
<html lang="de" class="h-full bg-slate-50 text-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Elbi Verlag | Schreiben lernen, Lehrerstempel, Schreiblehrgänge & Schulhefte</title>
    <!-- Google Fonts: Merriweather & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Outfit:wght@400;500;600;700;800&family=Fira+Code:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body {
        font-family: 'Outfit', sans-serif;
      }
      .font-serif {
        font-family: 'Merriweather', Georgia, serif;
      }
      .mono {
        font-family: 'Fira Code', monospace;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col justify-between selection:bg-sky-500 selection:text-white">

    <!-- TOP ANNOUNCEMENT BAR (ZERO TRUST BADGE & ACCESS HINT) -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold text-[10px] mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            ZERO TRUST GESCHÜTZT
          </span>
          <span class="text-slate-400">Interaktive Test-Umgebung &bull; D1 Live-Speicher</span>
        </div>
        <div class="flex items-center gap-4 mono text-xs">
          <a href="https://elbai.io/docs/" class="text-cyan-400 hover:text-cyan-300 underline font-semibold">
            📚 Dokumentation
          </a>
          <a href="https://elbai.io" class="text-slate-400 hover:text-white">
            ← Zu elbai.io
          </a>
        </div>
      </div>
    </div>

    <!-- AUTHENTIC ELBI STORE HEADER (ORIGINAL LOGO, NAVI, AND ACTIONS) -->
    <header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-2xs">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 py-3.5 gap-4">
        
        <!-- Authentic Logo -->
        <div class="flex items-center gap-3 shrink-0">
          <a href="/alpha" class="flex items-center gap-3 group">
            <img
              src="/images/branding/elbiLogo.png"
              alt="Elbi Verlag Logo"
              width="140"
              height="106"
              class="w-auto h-12 object-contain drop-shadow-2xs group-hover:scale-102 transition-transform duration-200"
            />
          </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1.5 text-slate-800 font-medium text-sm">
          <a href="/alpha" class="px-4 py-2 rounded-full bg-sky-50 text-sky-700 font-bold">
            Startseite
          </a>
          <a href="#katalog" class="px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-950 transition">
            Elbi Schreibhefte
          </a>
          <a href="#katalog" class="px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-950 transition">
            Lehrerstempel
          </a>
          <a href="https://elbai.io/docs/" class="px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-950 transition">
            Dokumentation
          </a>
        </nav>

        <!-- Right Side: Trust & Cart Badge (Exact match to official Header.astro) -->
        <div class="flex items-center gap-3 shrink-0">
          <div class="hidden lg:flex items-center gap-2 text-xs text-slate-600 bg-slate-50 px-3 py-1.5 rounded-full border border-slate-200">
            <span class="text-emerald-600 font-bold">✓</span>
            <span class="font-semibold">Kauf auf Rechnung für Schulen</span>
          </div>
          
          <!-- Official Cart Trigger Button matching Elbi Storefront exactly -->
          <button
            type="button"
            id="header-cart-btn"
            class="relative inline-flex items-center gap-2 h-10 px-3.5 py-2 text-[15px] font-medium text-slate-800 hover:text-slate-950 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0b57d0] rounded-full transition-all shrink-0 cursor-pointer"
            aria-label="Warenkorb öffnen"
          >
            <svg
              class="w-5 h-5 text-slate-700"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth="2"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
              />
            </svg>
            <span class="hidden sm:inline font-sans text-slate-800 font-medium">Warenkorb</span>
            <span
              id="header-cart-count"
              class="hidden items-center justify-center px-2 py-0.5 text-xs font-bold leading-none text-white bg-[#0b57d0] rounded-full"
            >
              0
            </span>
          </button>

          <!-- Official Konto Button matching Elbi Storefront -->
          <a
            href="https://elbai.io/docs/"
            class="inline-flex items-center gap-1.5 h-10 px-4.5 py-2 text-[14px] sm:text-[15px] font-medium text-white bg-[#0b57d0] hover:bg-[#0842a0] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0b57d0] rounded-full transition-all shrink-0 shadow-xs"
            title="Tester-Bereich &amp; Dokumentation"
          >
            <svg class="w-4 h-4 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>Konto</span>
          </a>
        </div>

      </div>
    </header>

    <!-- HERO SECTION (WITH VORSCHULE / LERNSTUFEN BOX & DER ELBI MASCOT) -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#f8fafd] via-[#f1f5f9]/20 to-white pt-4 pb-10 border-b border-slate-200/50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <!-- Live Dynamic Banner (Editable via Copilot) -->
        <div id="dynamic-alpha-banner" class="hidden mb-6 p-4 rounded-2xl border border-sky-300 bg-sky-100 text-sky-950 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="text-xl">📢</span>
            <div class="flex-1">
              <p id="dynamic-alpha-banner-text" class="text-sm font-bold leading-snug"></p>
            </div>
            <button id="close-dynamic-banner" class="text-xs text-sky-700 hover:text-sky-900 font-bold px-2 py-1 rounded">✕</button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Left: Hero Headline & Value Props -->
          <div class="lg:col-span-7 flex flex-col justify-center">
            
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200/80 text-[#0b57d0] text-xs font-bold tracking-wide mb-4 w-fit shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-[#ff9e00]"></span>
              <span>Offizielle Schulhefte &bull; Lineatur-Originale</span>
            </div>

            <!-- Dynamic Headline editable by Copilot -->
            <h1 id="shop-hero-headline" class="font-sans font-extrabold text-3xl sm:text-4xl lg:text-5xl text-slate-900 tracking-tight leading-[1.12]">
              Schreiben lernen mit System &amp; Freude.
            </h1>

            <!-- Dynamic Subtitle editable by Copilot -->
            <p id="shop-hero-subtitle" class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans max-w-2xl">
              Seit über 30 Jahren vertrauen Grundschulen und Förderschulen auf die bewährte Elbi-Lineaturverkleinerung. Entdecken Sie praxiserprobte Hefte, Schreiblehrgänge und Buchenholz-Lehrerstempel.
            </p>

            <!-- Trust Bar / Key USPs -->
            <div class="mt-6 flex flex-wrap gap-4 sm:gap-6 text-xs sm:text-sm text-slate-700 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Kauf auf Rechnung für Schulen</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Lieferung in 1–3 Werktagen</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>100% holzfreies Spezialpapier</span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="#katalog"
                class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-[#0b57d0] hover:bg-[#0842a0] text-white font-bold text-sm shadow-md hover:shadow-lg transition cursor-pointer"
              >
                Sortiment ansehen &darr;
              </a>
              <a
                href="#stufensystem"
                class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-white hover:bg-slate-100 text-slate-800 font-bold text-sm border border-slate-300 shadow-2xs transition"
              >
                Das Stufensystem entdecken
              </a>
            </div>

          </div>

          <!-- Right: Authentic "Vorschule bis Klasse 4" Box & Mascot Card -->
          <div class="lg:col-span-5">
            <div class="relative rounded-3xl bg-gradient-to-br from-white via-slate-50 to-blue-50/50 p-6 sm:p-7 border border-slate-200/90 shadow-xl overflow-hidden">
              
              <!-- Top Badge -->
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#1f6f9f] bg-blue-100/70">
                  Pädagogisches Stufenmodell
                </span>
                <span class="text-xs font-mono font-bold text-slate-400">H1–H44</span>
              </div>

              <!-- Mascot + Heading -->
              <div class="flex items-center gap-4 mb-4">
                <div class="w-16 h-16 rounded-2xl bg-white border border-blue-200/80 p-1 shadow-sm flex items-center justify-center shrink-0">
                  <img
                    src="/images/branding/elbiLogo.png"
                    alt="Der Elbi"
                    class="w-full h-full object-contain"
                  />
                </div>
                <div>
                  <h2 class="text-lg font-extrabold text-slate-900 leading-tight">
                    „Der Elbi“ führt durch alle Lernstufen
                  </h2>
                  <p class="text-xs text-slate-500 mt-0.5">
                    Vom Schwungübungsheft bis zur freien Schönschrift
                  </p>
                </div>
              </div>

              <!-- 4-Stage Mini Overview matching live store -->
              <div class="space-y-2 mt-4">
                <a href="#stufensystem" class="flex items-center justify-between p-2.5 rounded-xl bg-white hover:bg-blue-50/80 border border-slate-200/70 transition group">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-full bg-blue-100 text-[#0b57d0] text-xs font-bold flex items-center justify-center">1</span>
                    <span class="text-xs font-bold text-slate-800 group-hover:text-[#0b57d0]">Vorschule &amp; Förderschule</span>
                  </div>
                  <span class="text-[11px] text-slate-400 font-mono">H4, H44 &rarr;</span>
                </a>
                
                <a href="#stufensystem" class="flex items-center justify-between p-2.5 rounded-xl bg-white hover:bg-amber-50/80 border border-slate-200/70 transition group">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-800 text-xs font-bold flex items-center justify-center">2</span>
                    <span class="text-xs font-bold text-slate-800 group-hover:text-amber-800">1. Halbjahr Klasse 1</span>
                  </div>
                  <span class="text-[11px] text-slate-400 font-mono">H31, H10 &rarr;</span>
                </a>

                <a href="#stufensystem" class="flex items-center justify-between p-2.5 rounded-xl bg-white hover:bg-emerald-50/80 border border-slate-200/70 transition group">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center justify-center">3</span>
                    <span class="text-xs font-bold text-slate-800 group-hover:text-emerald-800">2. Halbjahr Klasse 1</span>
                  </div>
                  <span class="text-[11px] text-slate-400 font-mono">H2, H5, H12 &rarr;</span>
                </a>

                <a href="#stufensystem" class="flex items-center justify-between p-2.5 rounded-xl bg-white hover:bg-purple-50/80 border border-slate-200/70 transition group">
                  <div class="flex items-center gap-2.5">
                    <span class="w-6 h-6 rounded-full bg-purple-100 text-purple-800 text-xs font-bold flex items-center justify-center">4</span>
                    <span class="text-xs font-bold text-slate-800 group-hover:text-purple-800">Klasse 2 bis 4</span>
                  </div>
                  <span class="text-[11px] text-slate-400 font-mono">H25–H28 &rarr;</span>
                </a>
              </div>

              <!-- Extra Note -->
              <div class="mt-4 pt-3 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-500">
                <span>Patentierte Lineaturverkleinerung</span>
                <span class="font-semibold text-emerald-600">Sofort lieferbar</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- EDUCATIONAL JOURNEY: DAS ELBI-STUFENSYSTEM (AUTHENTIC TO REAL STORE) -->
    <section id="stufensystem" class="py-12 sm:py-16 bg-[#f8f9fa] border-b border-slate-200/60">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-10">
          <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#0b57d0] bg-blue-50 border border-blue-200/80 mb-2.5">
            Pädagogischer Aufbau
          </span>
          <h2 class="font-sans font-extrabold text-3xl sm:text-4xl text-slate-900 tracking-tight">
            Das Elbi-Stufensystem
          </h2>
          <p class="mt-2 text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
            In vier aufeinander aufbauenden Lernstufen führen unsere Schreibhefte Kinder behutsam von den ersten Schwungübungen bis zur freien Textgestaltung.
          </p>
        </div>

        <!-- 4 Spacious Stage Cards with Soft Pastel Surfaces -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
          <!-- Stage 1 -->
          <div class="group flex flex-col justify-between rounded-3xl p-7 sm:p-8 bg-[#f0f7fc] border border-blue-100/90 shadow-2xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-[#1f6f9f] bg-white border border-blue-200/60 shadow-2xs">
                  Stufe 1
                </span>
                <span class="text-2xl">🎨</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#3395d1] transition-colors font-sans tracking-tight">
                Vorschule &amp; Förderschule
              </h3>
              <p class="mt-3 text-base text-slate-600 leading-relaxed font-sans">
                Schwungübungen, Auge-Hand-Koordination und gezielte Vorübungen zur Entwicklung der Feinmotorik.
              </p>
              <div class="mt-5 pt-4 border-t border-blue-200/50">
                <span class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Klassiker:</span>
                <span class="block text-sm font-bold text-[#0b57d0] mt-0.5">Schwungheft H4 &amp; H44</span>
              </div>
            </div>
            <a href="#katalog" class="mt-6 flex items-center gap-1.5 text-sm font-bold text-[#0b57d0] group-hover:text-[#ff9e00] transition-colors">
              <span>Hefte im Katalog ansehen</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>

          <!-- Stage 2 -->
          <div class="group flex flex-col justify-between rounded-3xl p-7 sm:p-8 bg-[#fef9ee] border border-amber-100/90 shadow-2xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-amber-800 bg-white border border-amber-200/60 shadow-2xs">
                  Stufe 2
                </span>
                <span class="text-2xl">✏️</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-amber-700 transition-colors font-sans tracking-tight">
                1. Halbjahr Klasse 1
              </h3>
              <p class="mt-3 text-base text-slate-600 leading-relaxed font-sans">
                Druckschrift, Buchstabeneinführung und die ersten eigenen Wörter mit breiten Hilfslinien.
              </p>
              <div class="mt-5 pt-4 border-t border-amber-200/50">
                <span class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Klassiker:</span>
                <span class="block text-sm font-bold text-amber-900 mt-0.5">Schreibheft H31 &amp; Zahlenheft H10</span>
              </div>
            </div>
            <a href="#katalog" class="mt-6 flex items-center gap-1.5 text-sm font-bold text-amber-800 group-hover:text-amber-600 transition-colors">
              <span>Hefte im Katalog ansehen</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>

          <!-- Stage 3 -->
          <div class="group flex flex-col justify-between rounded-3xl p-7 sm:p-8 bg-[#f3f9f4] border border-emerald-100/90 shadow-2xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-emerald-800 bg-white border border-emerald-200/60 shadow-2xs">
                  Stufe 3
                </span>
                <span class="text-2xl">✒️</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-emerald-700 transition-colors font-sans tracking-tight">
                2. Halbjahr Klasse 1
              </h3>
              <p class="mt-3 text-base text-slate-600 leading-relaxed font-sans">
                Sanfter Übergang zur verbundenen Handschrift für alle Ausgangsschriften (VA, LA oder SAS).
              </p>
              <div class="mt-5 pt-4 border-t border-emerald-200/50">
                <span class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Klassiker:</span>
                <span class="block text-sm font-bold text-emerald-900 mt-0.5">Schreiblehrgänge H2, H5, H12</span>
              </div>
            </div>
            <a href="#katalog" class="mt-6 flex items-center gap-1.5 text-sm font-bold text-emerald-800 group-hover:text-emerald-600 transition-colors">
              <span>Hefte im Katalog ansehen</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>

          <!-- Stage 4 -->
          <div class="group flex flex-col justify-between rounded-3xl p-7 sm:p-8 bg-[#f8f4fb] border border-purple-100/90 shadow-2xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-purple-800 bg-white border border-purple-200/60 shadow-2xs">
                  Stufe 4
                </span>
                <span class="text-2xl">📖</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-purple-700 transition-colors font-sans tracking-tight">
                Klasse 2 bis 4
              </h3>
              <p class="mt-3 text-base text-slate-600 leading-relaxed font-sans">
                Schönschrift, Verfeinerung des Schriftbilds und erste zusammenhängende Geschichten &amp; Aufsätze.
              </p>
              <div class="mt-5 pt-4 border-t border-purple-200/50">
                <span class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Klassiker:</span>
                <span class="block text-sm font-bold text-purple-900 mt-0.5">Schönschreibhefte H25–H28</span>
              </div>
            </div>
            <a href="#katalog" class="mt-6 flex items-center gap-1.5 text-sm font-bold text-purple-800 group-hover:text-purple-600 transition-colors">
              <span>Hefte im Katalog ansehen</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PRODUCT CATALOG (ACTIVE BESTSELLERS) -->
    <section id="katalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-slate-200 mb-8">
        <div>
          <span class="text-xs font-bold text-sky-600 uppercase tracking-wider block mb-1">Original Sortiment</span>
          <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
            Praxiserprobte Hefte &amp; Lehrerstempel
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            {validProducts.length} sofort lieferbare Bestseller-Artikel
          </p>
        </div>

        <!-- Filter Controls -->
        <div class="flex items-center gap-2 text-xs font-semibold">
          <button id="filter-all-btn" class="filter-tab px-4 py-2 rounded-full bg-slate-900 text-white shadow-xs transition cursor-pointer">
            Alle ({validProducts.length})
          </button>
          <button id="filter-hefte-btn" class="filter-tab px-4 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 transition cursor-pointer">
            Schreibhefte
          </button>
          <button id="filter-stempel-btn" class="filter-tab px-4 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 transition cursor-pointer">
            Lehrerstempel
          </button>
        </div>
      </div>

