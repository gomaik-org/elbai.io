              href="https://dev.elbi.de/checkout"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#0b57d0] hover:bg-[#0842a0] text-white text-base font-bold shadow-md hover:shadow-lg transition cursor-pointer"
