---
import '../../styles/global.css';
import AlphaSandboxWidget from '../../components/AlphaSandboxWidget.astro';
import { getAllProducts, getCategoryBySlug } from '../../data/catalog';
import { shopConfig } from '../../config/shop.config';
import type { Product } from '../../types/shop';

export function getStaticPaths() {
  const products = getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = product.category_slug ? getCategoryBySlug(product.category_slug) : undefined;
const allProducts = getAllProducts();

function formatPriceEur(cents: number): string {
  return (cents / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
}

function resolveDescriptionContent(html: string | undefined): string {
  if (!html) return '';
  let content = html.replace(/href=["']([^"']+)["']/g, (match, rawHref: string) => {
    if (!rawHref.endsWith('.html')) return match;
    const clean = rawHref.split('?')[0].replace(/\.html$/, '');
    const slugPart = clean.split('/').pop()?.toLowerCase() || '';

    let matched = allProducts.find((p) => p.slug.toLowerCase() === slugPart);
    if (!matched) {
      matched = allProducts.find((p) => {
        const baseSlug = p.slug.replace(/-[a-z0-9]+$/, '').toLowerCase();
        return baseSlug === slugPart || slugPart.startsWith(baseSlug) || baseSlug.startsWith(slugPart);
      });
    }

    if (!matched) {
      if (slugPart.includes('mimikstempel-smiley-ergaenzungsset') || slugPart.includes('s89')) {
        matched = allProducts.find((p) => p.sku === 'S89/3');
      } else if (slugPart.includes('gesamtset-6-smileys') || slugPart.includes('s90')) {
        matched = allProducts.find((p) => p.sku === 'S90');
      } else if (slugPart.includes('holzstempel-erfolgsstempel') || slugPart.includes('erfolgsstempel-6-smileys') || slugPart.includes('erfolgsstempel')) {
        if (slugPart.includes('6-smileys')) {
          matched = allProducts.find((p) => p.sku === 'S89/3');
        } else {
          matched = allProducts.find((p) => p.sku === 'S88/5');
        }
      } else if (slugPart.includes('4-universalstempel-smileys') || slugPart.includes('smileys-lob-und-tadel')) {
        matched = allProducts.find((p) => p.sku === 'S88');
      } else if (slugPart.includes('schwunguebungen-mit-elbi')) {
        matched = allProducts.find((p) => p.sku === 'H4');
      } else if (slugPart.includes('schwungheft-klasse-1')) {
        matched = allProducts.find((p) => p.sku === 'H44');
      } else if (slugPart.includes('mein-erstes-elbi-schreibheft')) {
        matched = allProducts.find((p) => p.sku === 'H31');
      } else if (slugPart.includes('zahlenuebungsheft')) {
        matched = allProducts.find((p) => p.sku === 'H10');
      } else if (slugPart.includes('druckschrift')) {
        matched = allProducts.find((p) => p.sku === 'H12');
      } else if (slugPart.includes('lateinische-ausgangsschrift')) {
        matched = allProducts.find((p) => p.sku === 'H2');
      } else if (slugPart.includes('vereinfachte-ausgangsschrift')) {
        matched = allProducts.find((p) => p.sku === 'H5');
      } else if (slugPart.includes('schulausgangsschrift')) {
        return 'href="/alpha#katalog"';
      } else if (slugPart.includes('mit-elbi-schreiben-lernen')) {
        matched = allProducts.find((p) => p.sku === 'H3');
      } else if (slugPart.includes('klasse-1-2') || slugPart.includes('klasse-1-und-2')) {
        matched = allProducts.find((p) => p.sku === 'H25');
      } else if (slugPart.includes('klasse-2') || slugPart.includes('klasse-2-und')) {
        matched = allProducts.find((p) => p.sku === 'H26');
      } else if (slugPart.includes('klasse-3')) {
        matched = allProducts.find((p) => p.sku === 'H27');
      } else if (slugPart.includes('klasse-4')) {
        matched = allProducts.find((p) => p.sku === 'H28');
      }
    }

    if (matched) {
      return `href="/products/${matched.slug}"`;
    }
    return `href="/alpha#katalog"`;
  });

  content = content.replace(/src=["']\/out\/elbi\/img\/right\/S88\.5[^"']*["']/gi, 'src="/images/products/s88-5/main.jpg" class="rounded-xl border border-slate-200/80 shadow-2xs max-w-xs my-3 block"');
  content = content.replace(/\[\{\*[\s\S]*?\*\}\]/g, '');
  content = content.replace(/src=["']\/out\/[^"']+["']/gi, 'src="/images/placeholder.svg" class="hidden"');

  return content;
}

const resolvedDescription = resolveDescriptionContent(product.description);

function extractProductBadges(p: Product): string[] {
  const badges: string[] = [];
  const text = `${p.title} ${p.short_description || ''} ${p.description || ''}`;

  if (/DIN\s*A4\s*quer/i.test(text)) badges.push('DIN A4 Querformat');
  else if (/DIN\s*A5\s*hoch/i.test(text)) badges.push('DIN A5 Hochformat');
  else if (/DIN\s*A4/i.test(text)) badges.push('DIN A4');
  else if (/DIN\s*A5/i.test(text)) badges.push('DIN A5');

  const pagesMatch = text.match(/(\d+)\s*Seiten/i);
  if (pagesMatch) badges.push(`${pagesMatch[1]} Seiten`);

  if (/Vorschule/i.test(text)) badges.push('Vorschule & Förderschule');
  else if (/Klasse\s*1/i.test(text) || /1\.\s*Klasse/i.test(text) || /1\.\s*Schulhalbjahr/i.test(text)) badges.push('1. Schuljahr');
  else if (/Klasse\s*2/i.test(text) || /2\.\s*Klasse/i.test(text)) badges.push('2. Schuljahr');
  else if (/Klasse\s*3/i.test(text) || /4\.\s*Klasse/i.test(text)) badges.push('Klasse 2–4');

  if (/Lineaturverkleinerung/i.test(text)) badges.push('Lineaturverkleinerung');
  if (/durchschreibfest/i.test(text)) badges.push('Durchschreibfest');
  if (/Druckschrift/i.test(text)) badges.push('Druckschrift');
  if (/Schreibschrift/i.test(text) || /Schönschrift/i.test(text)) badges.push('Schreibschrift');
  if (/Holzstempel/i.test(text) || /Buchenholz/i.test(text)) badges.push('Echtes Buchenholz');
  if (/Stempelset/i.test(text)) badges.push('Stempelset');

  if (badges.length === 0) {
    if (p.category_slug?.includes('schreibhefte')) {
      badges.push('Schulheft', 'Praxiserprobt');
    } else if (p.category_slug?.includes('stempel')) {
      badges.push('Lehrerstempel', 'Präziser Abdruck');
    }
  }

  return badges.slice(0, 4);
}

const featureBadges = extractProductBadges(product);
const stockCount = product.stock ?? product.stock_quantity ?? 0;
const isAvailable = stockCount > 0;

const allImages: string[] = [];
if (product.gallery_images && product.gallery_images.length > 0) {
  for (const img of product.gallery_images) {
    if (!allImages.includes(img)) allImages.push(img);
  }
}
if (product.image_url && !allImages.includes(product.image_url)) {
  if (allImages.length === 0) {
    allImages.push(product.image_url);
  } else {
    const hasGallery1 = allImages.some((img) => img.includes('gallery-1.'));
    if (!hasGallery1) allImages.unshift(product.image_url);
  }
}
const primaryImage = allImages[0] || product.image_url || '/images/placeholder.svg';

const relatedProducts: Product[] = allProducts
  .filter((p) => p.id !== product.id && p.is_active)
  .filter((p) => {
    if (product.category_slug?.includes('schreibhefte')) {
      return p.sku === 'H44' || p.sku === 'H12' || p.sku === 'S88' || p.category_slug === product.category_slug;
    }
    return p.sku === 'S88' || p.sku === 'H4' || p.sku === 'S90' || p.category_slug === product.category_slug;
  })
  .slice(0, 3);
---

<!doctype html>
<html lang="de" class="h-full bg-slate-50 text-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{product.title} – ELBI Verlag</title>
    <meta name="description" content={product.short_description || `Kaufen Sie ${product.title} (Art.-Nr. ${product.sku}) direkt beim Elbi Verlag.`} />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Outfit:wght@400;500;600;700;800&family=Fira+Code:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-full flex flex-col justify-between selection:bg-sky-500 selection:text-white">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold text-[10px] font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            ZERO TRUST GESCHÜTZT
          </span>
          <span class="text-slate-400">Interaktive Test-Umgebung &bull; D1 Live-Speicher</span>
        </div>
        <div class="flex items-center gap-4 font-mono text-xs">
          <a href="https://elbai.io/docs/" class="text-cyan-400 hover:text-cyan-300 underline font-semibold">
            📚 Dokumentation
          </a>
          <a href="/alpha" class="text-slate-400 hover:text-white">
            ← Zurück zur Shop-Übersicht
          </a>
        </div>
      </div>
    </div>

    <!-- AUTHENTIC ELBI STORE HEADER -->
    <header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-2xs">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 py-3.5 gap-4">
        
        <!-- Logo -->
        <div class="flex items-center gap-3 shrink-0">
          <a href="/alpha" class="flex items-center gap-3 group">
            <img
              src="/images/branding/elbiLogo.png"
              alt="Elbi Verlag Logo"
              width="140"
              height="106"
              class="w-auto h-12 object-contain drop-shadow-2xs group-hover:scale-102 transition-transform duration-200"
            />
          </a>
        </div>

        <!-- Navigation -->
        <nav class="hidden md:flex items-center gap-1.5 text-slate-800 font-medium text-sm">
          <a href="/alpha" class="px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-950 transition">
            Startseite
          </a>
          <a href="/alpha#katalog" class="px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-950 transition">
            Elbi Schreibhefte
          </a>
          <a href="/alpha#katalog" class="px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-950 transition">
            Lehrerstempel
          </a>
          <a href="https://elbai.io/docs/" class="px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-950 transition">
            Dokumentation
          </a>
        </nav>

        <!-- Right Side: Trust & Cart -->
        <div class="flex items-center gap-3 shrink-0">
          <div class="hidden lg:flex items-center gap-2 text-xs text-slate-600 bg-slate-50 px-3 py-1.5 rounded-full border border-slate-200">
            <span class="text-emerald-600 font-bold">✓</span>
            <span class="font-semibold">Kauf auf Rechnung für Schulen</span>
          </div>

          <button
            type="button"
            id="header-cart-btn"
            class="relative inline-flex items-center gap-2 h-10 px-3.5 py-2 text-[15px] font-medium text-slate-800 hover:text-slate-950 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0b57d0] rounded-full transition-all shrink-0 cursor-pointer"
            aria-label="Warenkorb öffnen"
          >
            <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span class="hidden sm:inline font-sans text-slate-800 font-medium">Warenkorb</span>
            <span id="header-cart-count" class="hidden items-center justify-center px-2 py-0.5 text-xs font-bold leading-none text-white bg-[#0b57d0] rounded-full">
              0
            </span>
          </button>
        </div>

      </div>
    </header>

    <!-- MAIN PRODUCT DETAIL CONTENT -->
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 flex-1 w-full">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center flex-wrap gap-2 text-sm font-medium text-slate-500 mb-7" aria-label="Breadcrumb">
        <a href="/alpha" class="hover:text-[#3395d1] transition-colors">Startseite</a>
        <span class="text-slate-300">/</span>
        <a href="/alpha#katalog" class="hover:text-[#3395d1] transition-colors">Katalog</a>
        <span class="text-slate-300">/</span>
        {category && (
          <>
            <a href="/alpha#katalog" class="hover:text-[#3395d1] transition-colors">
              {category.title}
            </a>
            <span class="text-slate-300">/</span>
          </>
        )}
        <span class="text-slate-900 font-semibold truncate max-w-sm">{product.title}</span>
      </nav>

      <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 lg:items-start">
        
        <!-- Product Image Gallery Column -->
        <div class="flex flex-col">
          <div
            id="product-gallery-container"
            data-images={JSON.stringify(allImages)}
            class="relative aspect-[4/3] w-full overflow-hidden rounded-3xl border border-slate-200/80 bg-slate-50/70 p-4 sm:p-6 shadow-xs group/gallery flex items-center justify-center select-none"
          >
            {primaryImage ? (
              <img
                id="main-product-image"
                src={primaryImage}
                alt={product.title}
                class="h-full w-full object-contain p-2 sm:p-4 transition-all duration-200"
                onerror="this.onerror=null; this.src='/images/placeholder.svg'"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-gray-100 text-gray-400 font-bold">
                ELBI Verlag
              </div>
            )}

            {allImages.length > 1 && (
              <>
                <button
                  type="button"
                  id="gallery-prev-btn"
                  class="absolute left-3 top-1/2 -translate-y-1/2 h-11 w-11 rounded-full bg-white/95 hover:bg-white text-slate-800 shadow-md border border-slate-200 flex items-center justify-center cursor-pointer transition-all hover:scale-105 active:scale-95 z-10 opacity-90 hover:opacity-100"
                  aria-label="Vorheriges Bild"
                >
                  <svg class="h-6 w-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>

                <button
                  type="button"
                  id="gallery-next-btn"
                  class="absolute right-3 top-1/2 -translate-y-1/2 h-11 w-11 rounded-full bg-white/95 hover:bg-white text-slate-800 shadow-md border border-slate-200 flex items-center justify-center cursor-pointer transition-all hover:scale-105 active:scale-95 z-10 opacity-90 hover:opacity-100"
                  aria-label="Nächstes Bild"
                >
                  <svg class="h-6 w-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </button>

                <div
                  id="gallery-counter-badge"
                  class="absolute bottom-3 right-3 rounded-full bg-slate-900/80 backdrop-blur-xs px-3 py-1 text-xs font-semibold text-white tracking-wide shadow-md pointer-events-none"
                >
                  1 / {allImages.length}
                </div>
              </>
            )}
          </div>
        </div>

        <!-- Product Information Column -->
        <div class="mt-8 lg:mt-0">
          <div class="flex items-center justify-between gap-3 mb-3">
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#3395d1]">
              <span class="h-2 w-2 rounded-full bg-[#ff9e00]"></span>
              <span>{category ? category.title : 'Schulbedarf'}</span>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold font-mono text-slate-800 bg-slate-100 border border-slate-200/80 shadow-2xs">
              Art.-Nr. {product.sku}
            </span>
          </div>

          <h1 id="product-detail-title" class="font-sans text-2xl sm:text-3xl lg:text-[34px] font-extrabold tracking-tight text-slate-900 leading-tight">
            {product.title}
          </h1>

          <div class="mt-4 flex flex-wrap gap-2">
            {featureBadges.map((badge) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-slate-100/90 text-slate-700 border border-slate-200/80 shadow-2xs">
                {badge}
              </span>
            ))}
          </div>

          <!-- Price & Stock Box -->
          <div class="mt-6 p-6 rounded-3xl bg-slate-50/80 border border-slate-200/80 shadow-2xs">
            <div class="flex items-baseline gap-3 flex-wrap">
              <span class="text-3xl sm:text-4xl font-black text-slate-900 font-sans tracking-tight">
                {formatPriceEur(product.price_cents)}
              </span>
              {isAvailable ? (
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                  ● Sofort lieferbar (ca. 2–4 Werktage)
                </span>
              ) : (
                <span class="inline-flex items-center rounded-full bg-rose-50 px-3 py-1 text-xs font-bold text-rose-700 ring-1 ring-inset ring-rose-600/20">
                  ● Derzeit vergriffen (Lieferzeit auf Anfrage)
                </span>
              )}
            </div>

            <p class="mt-2.5 text-xs text-slate-500 font-medium leading-relaxed">
              inkl. {product.vat_percent ?? product.vat_rate ?? 19}% MwSt., zzgl. <a href="https://dev.elbi.de/versand" class="text-[#0b57d0] underline hover:text-[#0842a0] transition-colors">Versandkosten</a> (3,90 € zzgl. MwSt.). Mindestbestellwert 10,00 €. Bequemer Kauf auf Rechnung.
            </p>
          </div>

          <!-- Direct Add to Cart Button -->
          <div class="mt-6">
            <button
              type="button"
              id="pdp-add-to-cart-btn"
              disabled={!isAvailable}
              data-sku={product.sku}
              data-title={product.title}
              data-price={product.price_cents}
              data-image={product.image_url}
              class="w-full inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-[#0b57d0] hover:bg-[#0842a0] text-white text-base font-bold transition shadow-md hover:shadow-lg active:scale-98 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>In den Warenkorb legen</span>
            </button>
          </div>

          <!-- Description -->
          <div class="mt-8 border-t border-slate-200/80 pt-6">
            <h2 class="font-sans text-xl sm:text-2xl font-extrabold text-slate-900 mb-4 tracking-tight">
              Produktbeschreibung
            </h2>
            <div class="text-base sm:text-lg text-slate-700 leading-relaxed space-y-4 prose-desc font-sans" set:html={resolvedDescription} />
          </div>

          <!-- Info Accordions -->
          <div class="mt-8 space-y-3">
            <details class="group rounded-2xl border border-slate-200/90 bg-slate-50/60 transition-all open:bg-white open:shadow-xs">
              <summary class="flex cursor-pointer items-center justify-between p-4 sm:p-5 font-sans text-sm sm:text-base font-bold text-slate-900 select-none">
                <span class="flex items-center gap-2.5">
                  <svg class="h-5 w-5 text-[#3395d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  Produktsicherheit &amp; Herstellerangaben (GPSR)
                </span>
                <span class="ml-4 flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 group-hover:bg-slate-200 group-open:rotate-180 transition-transform duration-200 shrink-0">
                  <svg class="h-4 w-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="px-4 pb-5 sm:px-5 text-xs text-slate-600 leading-relaxed space-y-2 border-t border-slate-100 pt-3">
                <p>
                  <strong>Hersteller / Inverkehrbringer in der EU:</strong><br />
                  ELBI Verlag GmbH, Deutschland &bull; Kontakt: info@elbi.de
                </p>
                <p>
                  <strong>Produktidentifikation:</strong> SKU / Artikel-Nr. <span class="font-mono font-medium">{product.sku}</span>
                </p>
                <p>
                  <strong>Sicherheitshinweise:</strong> Für den bestimmungsgemäßen Gebrauch im Schul- und Büroalltag.
                </p>
              </div>
            </details>

            <details class="group rounded-2xl border border-slate-200/90 bg-slate-50/60 transition-all open:bg-white open:shadow-xs">
              <summary class="flex cursor-pointer items-center justify-between p-4 sm:p-5 font-sans text-sm sm:text-base font-bold text-slate-900 select-none">
                <span class="flex items-center gap-2.5">
                  <svg class="h-5 w-5 text-[#3395d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
