    <!-- COPILOT & SANDBOX COMPONENT -->
    <AlphaSandboxWidget />

    <!-- CLIENT SCRIPT -->
    <script is:inline>
      (function() {
        const CART_STORAGE_KEY = 'elbi_alpha_cart_v1';

        function getCart() {
          try {
            return JSON.parse(localStorage.getItem(CART_STORAGE_KEY) || '[]');
          } catch {
            return [];
          }
        }

        function saveCart(items) {
          localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(items));
          updateCartBadge();
          renderCartDrawer();
        }

        function updateCartBadge() {
          const items = getCart();
          const totalCount = items.reduce((acc, item) => acc + (item.quantity || 1), 0);
          const badge = document.getElementById('header-cart-count');
          if (badge) {
            if (totalCount > 0) {
              badge.textContent = String(totalCount);
              badge.classList.remove('hidden');
              badge.classList.add('inline-flex');
            } else {
              badge.classList.add('hidden');
              badge.classList.remove('inline-flex');
            }
          }
        }

        function openDrawer() {
          const drawer = document.getElementById('cart-drawer-dialog');
          if (drawer) {
            renderCartDrawer();
            drawer.classList.remove('hidden');
          }
        }

        function closeDrawer() {
          const drawer = document.getElementById('cart-drawer-dialog');
          if (drawer) drawer.classList.add('hidden');
        }

        function renderCartDrawer() {
          const container = document.getElementById('cart-drawer-items');
          if (!container) return;

          const items = getCart();
          if (items.length === 0) {
            container.innerHTML = '<div class="text-center py-12 text-slate-500 text-sm"><p>Ihr Warenkorb ist derzeit leer.</p></div>';
            document.getElementById('cart-drawer-subtotal').textContent = '0,00 €';
            document.getElementById('cart-drawer-vat').textContent = '0,00 €';
            document.getElementById('cart-drawer-total').textContent = '0,00 €';
            return;
          }

          let subtotalCents = 0;
          let html = '';

          items.forEach((it, idx) => {
            const price = Number(it.price_cents) || 0;
            const lineTotal = price * it.quantity;
            subtotalCents += lineTotal;

            html += `
              <div class="flex items-center gap-3 p-3 bg-white rounded-2xl border border-slate-200">
                <img src="${it.image_url || '/images/placeholder.svg'}" alt="${it.title}" class="w-14 h-14 object-contain rounded-lg bg-slate-50 p-1 border border-slate-100" />
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-mono text-slate-500 font-bold">${it.sku}</div>
                  <div class="text-sm font-bold text-slate-900 truncate">${it.title}</div>
                  <div class="text-xs text-slate-600">${(price / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' })}</div>
                </div>
                <div class="flex items-center gap-2">
                  <div class="flex items-center border border-slate-200 rounded-lg">
                    <button type="button" class="drawer-qty-minus px-2 py-1 text-slate-600 hover:bg-slate-100" data-idx="${idx}">-</button>
                    <span class="px-2 text-xs font-bold text-slate-900">${it.quantity}</span>
                    <button type="button" class="drawer-qty-plus px-2 py-1 text-slate-600 hover:bg-slate-100" data-idx="${idx}">+</button>
                  </div>
                  <button type="button" class="drawer-item-del text-red-500 hover:text-red-700 p-1" data-idx="${idx}">✕</button>
                </div>
              </div>
            `;
          });

          container.innerHTML = html;

          const vatCents = Math.round(subtotalCents * 0.19 / 1.19);
          const shippingCents = subtotalCents >= 5000 ? 0 : 390;
          const totalCents = subtotalCents + shippingCents;

          document.getElementById('cart-drawer-subtotal').textContent = (subtotalCents / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
          document.getElementById('cart-drawer-vat').textContent = (vatCents / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
          document.getElementById('cart-drawer-shipping').textContent = shippingCents === 0 ? 'Kostenlos' : '3,90 €';
          document.getElementById('cart-drawer-total').textContent = (totalCents / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });

          container.querySelectorAll('.drawer-qty-plus').forEach((btn) => {
            btn.onclick = () => {
              const idx = Number(btn.getAttribute('data-idx'));
              const c = getCart();
              if (c[idx]) {
                c[idx].quantity += 1;
                saveCart(c);
              }
            };
          });

          container.querySelectorAll('.drawer-qty-minus').forEach((btn) => {
            btn.onclick = () => {
              const idx = Number(btn.getAttribute('data-idx'));
              const c = getCart();
              if (c[idx]) {
                if (c[idx].quantity > 1) {
                  c[idx].quantity -= 1;
                } else {
                  c.splice(idx, 1);
                }
                saveCart(c);
              }
            };
          });

          container.querySelectorAll('.drawer-item-del').forEach((btn) => {
            btn.onclick = () => {
              const idx = Number(btn.getAttribute('data-idx'));
              const c = getCart();
              c.splice(idx, 1);
              saveCart(c);
            };
          });
        }

        const pdpAddBtn = document.getElementById('pdp-add-to-cart-btn');
        if (pdpAddBtn) {
          pdpAddBtn.onclick = function() {
            const sku = pdpAddBtn.getAttribute('data-sku');
            const title = pdpAddBtn.getAttribute('data-title');
            const price = Number(pdpAddBtn.getAttribute('data-price')) || 290;
            const img = pdpAddBtn.getAttribute('data-image');

            const cart = getCart();
            const existing = cart.find((x) => x.sku === sku);
            if (existing) {
              existing.quantity += 1;
            } else {
              cart.push({ sku, title, price_cents: price, image_url: img, quantity: 1 });
            }
            saveCart(cart);
            openDrawer();
          };
        }

        const headerCart = document.getElementById('header-cart-btn');
        if (headerCart) {
          headerCart.onclick = openDrawer;
        }

        const drawerClose = document.getElementById('cart-drawer-close-btn');
        if (drawerClose) drawerClose.onclick = closeDrawer;

        const backdrop = document.getElementById('cart-drawer-backdrop');
        if (backdrop) backdrop.onclick = closeDrawer;

        // Image Gallery
        const galleryContainer = document.getElementById('product-gallery-container');
        const mainImg = document.getElementById('main-product-image');
        const prevBtn = document.getElementById('gallery-prev-btn');
        const nextBtn = document.getElementById('gallery-next-btn');
        const counterBadge = document.getElementById('gallery-counter-badge');

        if (galleryContainer && mainImg) {
          let images = [];
          try {
            images = JSON.parse(galleryContainer.getAttribute('data-images') || '[]');
          } catch {}

          if (images.length > 1) {
            let activeIdx = 0;
            function updateImage(idx) {
              activeIdx = (idx + images.length) % images.length;
              mainImg.src = images[activeIdx];
              if (counterBadge) counterBadge.textContent = (activeIdx + 1) + ' / ' + images.length;
            }

            if (prevBtn) prevBtn.onclick = () => updateImage(activeIdx - 1);
            if (nextBtn) nextBtn.onclick = () => updateImage(activeIdx + 1);
          }
        }

        updateCartBadge();
      })();
    </script>
  </body>
</html>
